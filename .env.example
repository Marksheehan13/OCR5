# Copy this file to .env and fill in your own credentials.
# NEVER commit .env to GitHub.

# Pick your default provider from the names shown in the OCR5 sidebar.
OCR5_PROVIDER=Google Gemini (free tier)

# LLM provider key. Only the key for OCR5_PROVIDER is required.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Supabase invoice history
SUPABASE_URL=
SUPABASE_KEY=
