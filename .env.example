# Copy this file to .env and fill in your own credentials.
# NEVER commit .env to GitHub.

# OCR5 remembers the selected provider and its key locally.
OCR5_PROVIDER=Google Gemini (free tier)
OCR5_API_KEY=

# Supabase invoice history
SUPABASE_URL=
SUPABASE_KEY=

# Optional provider-specific keys if you prefer managing them separately.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
